---
import { existsSync, readFileSync } from 'node:fs';
import { sanitiseSvg } from '../../scripts/logo-lib.mjs';

/**
 * Purely decorative: every caller prints the institution's name as real text
 * beside it, so the mark is hidden from assistive tech rather than repeating
 * that name — or, worse, replacing a longer line and dropping the location.
 */
interface Props {
  /** Key from institutions.yaml, also the logo filename. */
  slug: string;
  monogram: string;
  size?: 'sm' | 'md';
}

const { slug, monogram, size = 'md' } = Astro.props;

// A supplied logo wins; the monogram is the designed fallback. The SVG is
// inlined rather than used through <img> so it can inherit type colour when it
// is drawn with currentColor. Sanitised again here, not only on fetch, so a
// file dropped in by hand cannot inject script into the page.
const path = `public/img/logos/${slug}.svg`;
const hasLogo = existsSync(path);
let svg = '';
if (hasLogo) {
  try {
    svg = sanitiseSvg(readFileSync(path, 'utf8'));
  } catch (err) {
    throw new Error(`public/img/logos/${slug}.svg is not usable as an inline SVG: ${err}`);
  }
}
---

<span class:list={['mark', `mark--${size}`, hasLogo && 'mark--logo']} aria-hidden="true">
  {hasLogo ? <Fragment set:html={svg} /> : monogram}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    color: var(--navy);
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }

  .mark--md {
    height: 2.25rem;
    min-width: 2.25rem;
    padding-inline: 0.45rem;
    font-size: 0.875rem;
  }

  .mark--sm {
    height: 1.75rem;
    min-width: 1.75rem;
    padding-inline: 0.35rem;
    font-size: 0.75rem;
  }

  /* Brand marks are drawn for a light ground, and most of these carry their own
     colours. A white tile in both themes keeps them correct instead of turning
     a dark wordmark invisible on the dark palette. */
  .mark--logo {
    background: #fff;
    border-color: color-mix(in srgb, var(--rule) 70%, #8a8a8a);
    color: #15181c;
  }

  .mark :global(svg) {
    display: block;
    width: auto;
  }

  /* Wordmarks vary wildly in aspect; cap the width so one wide mark cannot
     stretch the row. */
  .mark--md :global(svg) {
    height: 1.05rem;
    max-width: 6.5rem;
  }

  .mark--sm :global(svg) {
    height: 0.8rem;
    max-width: 5rem;
  }
</style>
