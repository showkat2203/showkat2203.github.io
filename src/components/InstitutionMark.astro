---
import { existsSync, readFileSync } from 'node:fs';
import { sanitiseSvg } from '../../scripts/logo-lib.mjs';

/**
 * Purely decorative: every caller prints the institution's name as real text
 * beside it, so the mark is hidden from assistive tech rather than repeating
 * that name — or, worse, replacing a longer line and dropping the location.
 *
 * Three tiers, best first:
 *   1. a downloaded file, inlined — themeable, measurable, no third-party request
 *   2. the remote `logoSource`, loaded by the visitor's browser
 *   3. the monogram
 *
 * Tier 2 exists so the row is complete before anyone runs `npm run logos:fetch`;
 * tier 1 takes over automatically once a file lands, with no content change.
 */
interface Props {
  /** Key from institutions.yaml, also the logo filename. */
  slug: string;
  monogram: string;
  /** Remote SVG to fall back to when no file has been downloaded. */
  logoSource?: string | null;
  /** Size nudge for a remote logo, which cannot be measured at build time. */
  logoScale?: number;
  size?: 'sm' | 'md';
}

const { slug, monogram, logoSource = null, logoScale = 1, size = 'md' } = Astro.props;

const path = `public/img/logos/${slug}.svg`;
const hasFile = existsSync(path);

let svg = '';
let markHeight = 0;

if (hasFile) {
  try {
    svg = sanitiseSvg(readFileSync(path, 'utf8'));
  } catch (err) {
    throw new Error(`public/img/logos/${slug}.svg is not usable as an inline SVG: ${err}`);
  }

  // The viewBox is fitted to the mark's ink bounds by `npm run logos`, so it is
  // the true aspect ratio of the artwork.
  const box = svg.match(/viewBox="([^"]+)"/);
  const [, , boxW, boxH] = box ? box[1].trim().split(/[\s,]+/).map(Number) : [];
  const aspect = boxW && boxH ? boxW / boxH : 1;

  /**
   * Sized by optical area, not by height. Matching heights makes a wide
   * wordmark several times heavier than a square crest, which is what makes
   * untuned logo rows look ragged. The 0.4 exponent softens full area
   * normalisation, which would shrink a 6:1 wordmark past readability; the
   * floor and width cap keep every mark legible and inside its box.
   */
  const s = size === 'md' ? 1 : 0.76;
  markHeight = Math.min(Math.max((18 * s) / aspect ** 0.4, 10 * s), 20 * s);
  const maxW = size === 'md' ? 68 : 58;
  if (markHeight * aspect > maxW) markHeight = maxW / aspect;
}

const useRemote = !hasFile && Boolean(logoSource);
const hasLogo = hasFile || useRemote;
---

<span
  class:list={['mark', `mark--${size}`, hasLogo && 'mark--logo', useRemote && 'mark--remote']}
  aria-hidden="true"
  style={[
    markHeight ? `--mark-h:${markHeight.toFixed(2)}px` : null,
    useRemote && logoScale !== 1 ? `--mark-scale:${logoScale}` : null,
  ]
    .filter(Boolean)
    .join(';') || undefined}
>
  {hasFile && <Fragment set:html={svg} />}
  {
    useRemote && (
      <img
        src={logoSource!}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="this.remove()"
      />
    )
  }
  <span class="mark__mono">{monogram}</span>
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    color: var(--navy);
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }

  .mark--md {
    height: 2.25rem;
    min-width: 2.25rem;
    padding-inline: 0.45rem;
    font-size: 0.875rem;
  }

  .mark--sm {
    height: 1.75rem;
    min-width: 1.75rem;
    padding-inline: 0.35rem;
    font-size: 0.75rem;
  }

  /* Brand marks are drawn for a light ground, and most carry their own colours.
     A white tile in both themes keeps them correct instead of turning a dark
     wordmark invisible on the dark palette. */
  .mark--logo {
    background: #fff;
    border-color: color-mix(in srgb, var(--rule) 70%, #8a8a8a);
    color: #15181c;
  }

  /* One tile footprint across the credibility row, whatever shape the artwork
     is, so the row reads as a set rather than a ragged line. */
  .mark--logo.mark--md {
    width: 5rem;
    padding-inline: 0.35rem;
  }

  .mark--logo.mark--sm {
    width: 3.5rem;
    padding-inline: 0.25rem;
  }

  /* The monogram stays in the DOM as the fallback. It is hidden while a mark is
     actually present, and an image that fails to load removes itself, so a dead
     URL reveals the monogram rather than a broken-image icon. */
  .mark:has(svg) .mark__mono,
  .mark:has(img) .mark__mono {
    display: none;
  }

  .mark :global(svg) {
    display: block;
    width: auto;
    height: var(--mark-h, 1rem);
    max-width: 100%;
  }

  /* A remote logo cannot be measured at build time, so it is contained in the
     tile instead of area-normalised: the tighter dimension decides, which
     keeps every mark inside its box whatever its shape. */
  .mark--remote img {
    display: block;
    max-width: calc(100% * var(--mark-scale, 1));
    max-height: calc(56% * var(--mark-scale, 1));
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>
