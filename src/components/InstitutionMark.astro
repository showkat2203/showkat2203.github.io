---
import { existsSync, readFileSync } from 'node:fs';
import { sanitiseSvg } from '../../scripts/logo-lib.mjs';

/**
 * Purely decorative: every caller prints the institution's name as real text
 * beside it, so the mark is hidden from assistive tech rather than repeating
 * that name — or, worse, replacing a longer line and dropping the location.
 */
interface Props {
  /** Key from institutions.yaml, also the logo filename. */
  slug: string;
  monogram: string;
  size?: 'sm' | 'md';
}

const { slug, monogram, size = 'md' } = Astro.props;

// A supplied logo wins; the monogram is the designed fallback. The SVG is
// inlined rather than used through <img> so it can inherit type colour when it
// is drawn with currentColor. Sanitised again here, not only on fetch, so a
// file dropped in by hand cannot inject script into the page.
const path = `public/img/logos/${slug}.svg`;
const hasLogo = existsSync(path);
let svg = '';
let markHeight = 0;

if (hasLogo) {
  try {
    svg = sanitiseSvg(readFileSync(path, 'utf8'));
  } catch (err) {
    throw new Error(`public/img/logos/${slug}.svg is not usable as an inline SVG: ${err}`);
  }

  // The viewBox is fitted to the mark's ink bounds by `npm run logos`, so it is
  // the true aspect ratio of the artwork.
  const box = svg.match(/viewBox="([^"]+)"/);
  const [, , boxW, boxH] = box ? box[1].trim().split(/[\s,]+/).map(Number) : [];
  const aspect = boxW && boxH ? boxW / boxH : 1;

  /**
   * Logos are sized by optical area, not by height.
   *
   * Matching heights makes a wide wordmark enormously heavier than a square
   * crest, which is why untuned logo rows look ragged. Scaling so that area is
   * roughly constant equalises the weight; the 0.4 exponent softens full area
   * normalisation, which would shrink a 6:1 wordmark past readability. The
   * floor and the width cap then keep every mark legible and inside its box.
   */
  const s = size === 'md' ? 1 : 0.76;
  const REF = 18 * s;
  const MIN = 10 * s;
  const MAX = 20 * s;
  const MAX_W = (size === 'md' ? 68 : 58) * 1;

  markHeight = Math.min(Math.max(REF / aspect ** 0.4, MIN), MAX);
  if (markHeight * aspect > MAX_W) markHeight = MAX_W / aspect;
}
---

<span
  class:list={['mark', `mark--${size}`, hasLogo && 'mark--logo']}
  aria-hidden="true"
  style={markHeight ? `--mark-h:${markHeight.toFixed(2)}px` : undefined}
>
  {hasLogo ? <Fragment set:html={svg} /> : monogram}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    color: var(--navy);
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }

  .mark--md {
    height: 2.25rem;
    min-width: 2.25rem;
    padding-inline: 0.45rem;
    font-size: 0.875rem;
  }

  .mark--sm {
    height: 1.75rem;
    min-width: 1.75rem;
    padding-inline: 0.35rem;
    font-size: 0.75rem;
  }

  /* Brand marks are drawn for a light ground, and most carry their own colours.
     A white tile in both themes keeps them correct instead of turning a dark
     wordmark invisible on the dark palette. */
  .mark--logo {
    background: #fff;
    border-color: color-mix(in srgb, var(--rule) 70%, #8a8a8a);
    color: #15181c;
  }

  /* One tile footprint across the credibility row, whatever shape the artwork
     is, so the row reads as a set rather than a ragged line. */
  .mark--logo.mark--md {
    width: 5rem;
    padding-inline: 0.35rem;
  }

  .mark :global(svg) {
    display: block;
    width: auto;
    height: var(--mark-h, 1rem);
    max-width: 100%;
  }
</style>
