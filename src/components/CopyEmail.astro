---
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<span class="copy">
  <a href={`mailto:${email}`}>{email}</a>
  <button type="button" class="copy__btn" data-copy={email}>Copy</button>
  <span class="copy__said mono" role="status" aria-live="polite"></span>
</span>

<style>
  .copy {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
  }

  .copy__btn {
    font: inherit;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--sec);
    background: var(--tint);
    border: 0;
    border-radius: var(--r);
    padding: 0.15rem 0.45rem;
    cursor: pointer;
  }

  .copy__btn:hover {
    color: var(--navy);
  }

  .copy__said {
    font-size: var(--t-small);
    color: var(--sec);
    opacity: 0;
    transition: opacity 140ms linear;
  }

  .copy__said[data-shown] {
    opacity: 1;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy__btn').forEach((btn) => {
    const said = btn.parentElement?.querySelector<HTMLElement>('.copy__said');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (said) {
          said.textContent = 'copied';
          said.setAttribute('data-shown', '');
          window.setTimeout(() => said.removeAttribute('data-shown'), 2000);
        }
      } catch {
        if (said) {
          said.textContent = 'press ctrl+c';
          said.setAttribute('data-shown', '');
        }
      }
    });
  });
</script>
