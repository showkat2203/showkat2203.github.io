---
/**
 * The booking call to action.
 *
 * Two working states, no broken one. With a Cal.com link configured it is an
 * outbound link to the booking page; without one it is the real email address.
 * Either way it is a plain anchor, so it works with no JavaScript and the
 * outbound-link pass gives the Cal.com version its own tab and its note.
 *
 * Deliberately not an inline embed: that means a third-party script and a modal
 * on a site that currently loads neither, and the booking page Cal.com hosts is
 * already a better one than an embed of it.
 */
interface Props {
  url: string | null;
  email: string;
  /** Ghost rather than primary where the page already has a primary above. */
  variant?: 'primary' | 'ghost';
  subject?: string;
}

const { url, email, variant = 'primary', subject = 'Interview prep session' } = Astro.props;
const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

{
  url ? (
    <a class={`btn btn--${variant}`} href={url}>
      See available times on Cal.com
    </a>
  ) : (
    <a class={`btn btn--${variant}`} href={mailto}>
      Email me to arrange a time
    </a>
  )
}
