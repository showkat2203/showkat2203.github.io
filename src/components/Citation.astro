---
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>['data'];
  selfAliases: string[];
  index?: number;
  level?: 'h3' | 'h4';
  /** Citations for this paper. Omitted where the count is not known. */
  citations?: number;
}

const { pub, selfAliases, index, level = 'h3', citations } = Astro.props;
const Heading = level;

const href = pub.doi ? `https://doi.org/${pub.doi}` : pub.url;

// Link text has to say where it goes; a DOI's registrant prefix identifies the
// publisher, so name that rather than reading "doi.org" twelve times over.
const REGISTRANTS: Record<string, string> = {
  '10.1016': 'ScienceDirect',
  '10.1145': 'ACM Digital Library',
  '10.1007': 'SpringerLink',
  '10.3390': 'MDPI',
  '10.5220': 'SciTePress',
  '10.1109': 'IEEE Xplore',
};
const HOSTS: Record<string, string> = {
  'ieeexplore.ieee.org': 'IEEE Xplore',
  'dl.acm.org': 'ACM Digital Library',
  'link.springer.com': 'SpringerLink',
  'arxiv.org': 'arXiv',
};

let linkLabel = '';
if (pub.doi) {
  linkLabel = REGISTRANTS[pub.doi.split('/')[0]] ?? 'Publisher page';
} else if (href) {
  try {
    const host = new URL(href).hostname.replace(/^www\./, '');
    linkLabel = HOSTS[host] ?? host;
  } catch {
    linkLabel = 'Publisher page';
  }
}
---

<article class="cite">
  {index !== undefined && <span class="cite__i mono" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
  <div class="cite__main">
    <Heading class="cite__title">{pub.title}</Heading>
    <p class="cite__authors">
      {
        pub.authors.map((author, i) => (
          <>
            {i > 0 ? ', ' : ''}
            {selfAliases.includes(author) ? <b>{author}</b> : author}
          </>
        ))
      }
    </p>
    <p class="cite__line">
      <span class="badge">{pub.venueShort}</span>
      <span class="mono cite__y">{pub.year}</span>
      {pub.details && <span class="cite__d">{pub.details}</span>}
      {
        href && (
          <a class="cite__link" href={href} rel="noopener">
            Read on {linkLabel}
          </a>
        )
      }
    </p>
    {pub.doi && <p class="cite__doi mono">doi {pub.doi}</p>}
    {
      typeof citations === 'number' && (
        <p class="cite__n mono">
          {citations === 0 ? 'not yet cited' : `cited by ${citations}`}
        </p>
      )
    }
  </div>
</article>

<style>
  .cite {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.9rem;
  }

  .cite:not(:has(.cite__i)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .cite__i {
    font-size: var(--t-meta);
    color: var(--navy);
    padding-top: 0.28rem;
  }

  .cite__title {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.008em;
    text-wrap: pretty;
    max-width: 44rem;
  }

  .cite__authors {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--sec);
    line-height: 1.5;
    max-width: 46rem;
  }

  .cite__authors b {
    color: var(--ink);
    font-weight: 600;
  }

  .cite__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.9rem;
    margin-top: 0.6rem;
    font-size: var(--t-meta);
    color: var(--sec);
  }

  .cite__y {
    font-size: var(--t-meta);
  }

  .cite__link {
    font-weight: 500;
  }

  .cite__n {
    margin-top: 0.3rem;
    font-size: var(--t-small);
    color: var(--sec);
  }

  .cite__doi {
    margin-top: 0.3rem;
    font-size: var(--t-small);
    color: var(--sec);
    opacity: 0.85;
  }

  @media print {
    .cite__link {
      display: none;
    }
    .cite__title {
      font-size: 10.5pt;
    }
    .cite__authors {
      font-size: 9pt;
      margin-top: 0.1rem;
    }
    .cite__line {
      margin-top: 0.15rem;
    }
    .badge {
      background: none;
      color: #000;
      border: 1px solid #999;
      padding: 0 0.25rem;
    }
  }
</style>
