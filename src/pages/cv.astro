---
import Base from '../layouts/Base.astro';
import Citation from '../components/Citation.astro';
import InstitutionMark from '../components/InstitutionMark.astro';
import { getCollection, getEntry } from 'astro:content';
import { buildRecord, fillTokens } from '../lib/record';
import { personId } from '../lib/schema';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile.yaml is missing the "main" record');
const p = profile.data;

const experience = (await getCollection('experience')).sort(
  (a, b) => b.data.start.localeCompare(a.data.start) || a.data.order - b.data.order,
);
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const sections = (await getCollection('cv')).sort((a, b) => a.data.order - b.data.order);
const education = sections.find((s) => s.id === 'education');
const extras = sections.filter((s) => s.id !== 'education');

const institutions = await getCollection('institutions');
const byKey = new Map(institutions.map((i) => [i.id, i.data]));

const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const journals = pubs.filter((x) => x.data.type === 'journal');
const conferences = pubs.filter((x) => x.data.type === 'conference');

const record = buildRecord(pubs);
---

<Base
  title={`CV — ${p.name}`}
  trail={[{ name: 'CV', path: '/cv/' }]}
  mainEntity={personId(new URL('/', Astro.site!))}
  aboutPerson
  description={`Curriculum vitae of ${p.name}: seven years across embedded firmware, distributed cloud infrastructure, and graph machine learning research, with ${record.publications} peer-reviewed publications.`}
  current="cv"
>
  <div class="shell head">
    <p class="kicker">Curriculum vitae</p>
    <h1 class="page__t">{p.name}</h1>
    <p class="lede measure">{fillTokens(p.positioning, record)}</p>
    <p class="head__meta">
      {p.location} — {p.residency} — <a href={`mailto:${p.email}`}>{p.email}</a>
    </p>

    <div class="head__cta no-print">
      <a class="btn btn--primary" href={p.cv.hosted} download>Download PDF</a>
      {p.cv.drive && <a class="btn btn--ghost" href={p.cv.drive}>Open in Google Drive</a>}
      {p.cv.latex && <a class="btn btn--ghost" href={p.cv.latex}>LaTeX source on Overleaf</a>}
    </div>
  </div>

  <div class="shell">
    <section class="section cv-sec" aria-labelledby="cv-rec">
      <h2 class="h2" id="cv-rec">Research record</h2>
      <p class="cv-note measure">
        {record.publications} peer-reviewed publications. Venues include{' '}
        {record.venues.slice(0, -1).join(', ')}, and {record.venues.at(-1)}.
      </p>
    </section>

    {
      education && (
        <section class="section cv-sec" aria-labelledby="cv-edu">
          <h2 class="h2" id="cv-edu">{education.data.heading}</h2>
          {education.data.entries?.map((e) => (
            <article class="cv-entry">
              <p class="cv-when mono">{e.period}</p>
              <div>
                <h3 class="cv-t">
                  {e.institutionKey && byKey.get(e.institutionKey) && (
                    <InstitutionMark
                      slug={e.institutionKey}
                      monogram={byKey.get(e.institutionKey)!.monogram}
                      logoSource={byKey.get(e.institutionKey)!.logoSource}
                      logoScale={byKey.get(e.institutionKey)!.logoScale}
                      size="sm"
                    />
                  )}
                  <span>{e.institution}</span>
                </h3>
                <p class="cv-sub">{e.qualification}, {e.location}</p>
                {e.notes.length > 0 && (
                  <ul class="bullets">{e.notes.map((n) => <li>{n}</li>)}</ul>
                )}
              </div>
            </article>
          ))}
        </section>
      )
    }

    <section class="section cv-sec" aria-labelledby="cv-exp">
      <h2 class="h2" id="cv-exp">Experience</h2>
      {
        experience.map((role) => (
          <article class="cv-entry">
            <p class="cv-when mono">{role.data.period}</p>
            <div>
              <h3 class="cv-t">{role.data.role}</h3>
              <p class="cv-sub">
                {byKey.get(role.data.institution) && (
                  <InstitutionMark
                    slug={role.data.institution}
                    monogram={byKey.get(role.data.institution)!.monogram}
                    logoSource={byKey.get(role.data.institution)!.logoSource}
                    logoScale={byKey.get(role.data.institution)!.logoScale}
                    size="sm"
                  />
                )}
                <span>{role.data.org}, {role.data.location}</span>
              </p>
              {role.data.context && <p class="cv-context">{role.data.context}</p>}
              {role.data.bullets.length > 0 ? (
                <ul class="bullets">{role.data.bullets.map((b) => <li>{b}</li>)}</ul>
              ) : (
                role.data.summary && <p class="cv-note">{role.data.summary}</p>
              )}
            </div>
          </article>
        ))
      }
    </section>

    <section class="section cv-sec" aria-labelledby="cv-skills">
      <h2 class="h2" id="cv-skills">Technical range</h2>
      {
        skills.map((g) => (
          <article class="cv-entry">
            <p class="cv-when">{g.data.heading}</p>
            <div><p class="cv-note">{g.data.items}</p></div>
          </article>
        ))
      }
    </section>

    <section class="section cv-sec" aria-labelledby="cv-pubs">
      <h2 class="h2" id="cv-pubs">Publications</h2>

      <h3 class="cv-group">Journal articles</h3>
      <ol class="cv-pubs">
        {journals.map((pub) => <li><Citation pub={pub.data} selfAliases={p.selfAliases} level="h4" /></li>)}
      </ol>

      <h3 class="cv-group">Conference papers</h3>
      <ol class="cv-pubs">
        {conferences.map((pub) => <li><Citation pub={pub.data} selfAliases={p.selfAliases} level="h4" /></li>)}
      </ol>
    </section>

    {
      extras.map((s) => (
        <section class="section cv-sec" aria-labelledby={`cv-${s.id}`}>
          <h2 class="h2" id={`cv-${s.id}`}>{s.data.heading}</h2>
          <ul class="bullets bullets--wide">{s.data.items?.map((i) => <li>{i}</li>)}</ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .page__t {
    font-family: var(--serif);
    font-size: var(--t-page);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-top: 0.35rem;
  }

  .head .lede {
    margin-top: 0.85rem;
  }

  .head__meta {
    margin-top: 0.85rem;
    font-size: var(--t-meta);
    color: var(--sec);
  }

  .head__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-top: 1.35rem;
  }

  .cv-sec {
    padding-top: clamp(2.25rem, 4.5vw, 3rem);
  }

  .cv-sec .h2 {
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--navy);
    margin-bottom: 1.1rem;
  }


  .cv-entry {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.3rem 1.5rem;
    padding-block: 0.85rem;
  }

  .cv-when {
    font-size: var(--t-meta);
    color: var(--sec);
    padding-top: 0.15rem;
  }

  .cv-t {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .cv-sub {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-size: var(--t-meta);
    color: var(--sec);
    margin-top: 0.3rem;
  }

  /* One line on the system, so the bullets can be about the contribution. */
  .cv-context {
    margin-top: 0.3rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--sec);
    max-width: 52rem;
    text-wrap: pretty;
  }

  .cv-note {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--sec);
    text-wrap: pretty;
  }

  .bullets {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9375rem;
    color: var(--sec);
  }

  .bullets--wide {
    max-width: 54rem;
  }

  .bullets li {
    position: relative;
    padding-left: 1rem;
    text-wrap: pretty;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 1px;
    background: var(--navy);
  }

  .cv-group {
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .cv-pubs {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 46rem) {
    .cv-entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media print {
    .head {
      padding-top: 0;
    }
    .page__t {
      font-size: 19pt;
    }
    .cv-sec {
      padding-top: 0.9rem;
    }
    .cv-sec .h2 {
      font-size: 12pt;
      margin-bottom: 0.5rem;
      padding-bottom: 0.25rem;
      border-bottom-width: 1px;
    }
    .cv-entry {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      padding-block: 0.3rem;
    }
    .cv-t {
      font-size: 10.5pt;
    }
    .cv-context {
      font-size: 9pt;
      margin-top: 0.15rem;
    }

    .cv-note,
    .bullets {
      font-size: 9.5pt;
      margin-top: 0.2rem;
      gap: 0.18rem;
    }
    .cv-pubs {
      gap: 0.5rem;
    }
    .cv-group {
      font-size: 10.5pt;
      margin-top: 0.5rem;
    }
  }
</style>
