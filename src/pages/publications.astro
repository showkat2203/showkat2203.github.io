---
import Base from '../layouts/Base.astro';
import Citation from '../components/Citation.astro';
import { getCollection, getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile.yaml is missing the "main" record');
const p = profile.data;

const pubs = (await getCollection('publications')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return a.data.title.localeCompare(b.data.title);
});

const counts = {
  all: pubs.length,
  journal: pubs.filter((x) => x.data.type === 'journal').length,
  conference: pubs.filter((x) => x.data.type === 'conference').length,
};
---

<Base
  title={`Publications — ${p.name}`}
  description={`All ${counts.all} peer-reviewed publications by ${p.name}: ${counts.journal} journal articles and ${counts.conference} conference papers in IEEE/ACM ASE, ECSA, CLOSER, Journal of Systems and Software, Cluster Computing, Electronics, and Telecom.`}
  current="publications"
>
  <div class="shell head">
    <h1 class="page__title">Publications</h1>
    <p class="page__lede measure">
      {counts.all} peer-reviewed papers, {p.record.citations} citations, h-index
      {p.record.hIndex}. Work on graph learning over dependency graphs, microservice
      architecture, and measured comparisons of concurrent systems.
    </p>
    {
      !p.links.scholar.url && (
        <p class="page__pending mono">
          Google Scholar profile: link pending. Citation counts are current as of the
          most recent update to this site.
        </p>
      )
    }
  </div>

  <div class="spined">
    <section class="section shell" aria-labelledby="list-title">
      <h2 class="sr-only" id="list-title">All publications</h2>

      <div class="filter" data-filter>
        <span class="filter__label mono" id="filter-label">Show</span>
        <div class="filter__group" role="group" aria-labelledby="filter-label">
          <button type="button" data-type="all" aria-pressed="true">
            All <span class="mono">{counts.all}</span>
          </button>
          <button type="button" data-type="journal" aria-pressed="false">
            Journal articles <span class="mono">{counts.journal}</span>
          </button>
          <button type="button" data-type="conference" aria-pressed="false">
            Conference papers <span class="mono">{counts.conference}</span>
          </button>
        </div>
      </div>

      <ol class="pubs" data-list>
        {
          pubs.map((pub) => (
            <li class="band pub" data-type={pub.data.type}>
              <div class="band__rail">
                <span class="band__figure">{pub.data.year}</span>
                <span class="band__unit">{pub.data.venueShort}</span>
              </div>
              <div class="band__body">
                <Citation pub={pub.data} selfAliases={p.selfAliases} />
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 0;
  }

  .page__title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-variation-settings: 'wght' 500, 'wdth' 94;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .page__lede {
    margin-top: 1rem;
    color: var(--graphite);
    font-size: var(--t-lead);
    text-wrap: pretty;
  }

  .page__pending {
    margin-top: 1rem;
    font-size: var(--t-meta);
    color: var(--tick);
    border-left: 2px solid var(--hairline);
    padding-left: 0.75rem;
    max-width: var(--measure);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .filter__label {
    font-size: var(--t-unit);
    color: var(--tick);
  }

  .filter__group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }

  .filter button {
    font: inherit;
    font-size: var(--t-meta);
    color: var(--graphite);
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0 0 2px;
    cursor: pointer;
  }

  .filter button:hover {
    color: var(--ink);
  }

  .filter button[aria-pressed='true'] {
    color: var(--ink);
    font-variation-settings: 'wght' 600, 'wdth' 100;
    border-bottom-color: var(--ink);
  }

  .filter button .mono {
    color: var(--tick);
    font-size: var(--t-unit);
  }

  .pubs .pub {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .pubs .pub:last-child {
    border-bottom: 0;
  }

  .pubs .pub[hidden] {
    display: none;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  const list = document.querySelector<HTMLElement>('[data-list]');
  if (root && list) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button'));
    const items = Array.from(list.querySelectorAll<HTMLElement>('.pub'));
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const wanted = btn.dataset.type ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((item) => {
          item.hidden = wanted !== 'all' && item.dataset.type !== wanted;
        });
      });
    });
  }
</script>
