---
import Base from '../layouts/Base.astro';
import Citation from '../components/Citation.astro';
import { getCollection, getEntry } from 'astro:content';
import { buildRecord, formatAsOf } from '../lib/record';
import { publicationListNode, publicationNode } from '../lib/schema';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile.yaml is missing the "main" record');
const p = profile.data;

const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);

const counts = {
  all: pubs.length,
  journal: pubs.filter((x) => x.data.type === 'journal').length,
  conference: pubs.filter((x) => x.data.type === 'conference').length,
};

const scholar = await getEntry('scholar', 'main');
if (!scholar) throw new Error('src/content/scholar.yaml is missing the "main" record');
const record = buildRecord(pubs, scholar.data);
---

<Base
  title={`Publications — ${p.name}`}
  pageType="CollectionPage"
  trail={[{ name: 'Publications', path: '/publications/' }]}
  mainEntity={`${new URL('/publications/', Astro.site!).href}#list`}
  aboutPerson
  schema={(ctx) => [publicationListNode(ctx.site, pubs), ...pubs.map((pub) => publicationNode(ctx.site, pub))]}
  description={`All ${counts.all} peer-reviewed publications by ${p.name}: ${counts.journal} journal articles and ${counts.conference} conference papers in ${record.venues.slice(0, 6).join(', ')}, and elsewhere.`}
  current="publications"
>
  <div class="shell head">
    <h1 class="page__t">Publications</h1>
    <p class="lede measure">
      Graph learning over dependency graphs, microservice architecture, and
      measured comparisons of concurrent systems.
    </p>

    <dl class="rec" data-figures data-rule>
      <div><dt data-figure={record.publications}>{record.publications}</dt><dd>peer-reviewed papers</dd></div>
      <div><dt data-figure={record.citations}>{record.citations}</dt><dd>citations</dd></div>
      <div><dt data-figure={record.hIndex}>{record.hIndex}</dt><dd>h-index</dd></div>
    </dl>
    <p class="rec__src">
      The paper count is the list below. Citations and h-index are from
      <a href={p.links.scholar.url}>Google Scholar</a>, read {formatAsOf(record.asOf)}.
    </p>
  </div>

  <div class="shell section">
    <h2 class="sr-only">All publications</h2>

    <div class="filter" data-filter>
      <span class="filter__l mono" id="filter-label">Show</span>
      <div class="filter__g" role="group" aria-labelledby="filter-label">
        <button type="button" data-type="all" aria-pressed="true">All <span class="mono">{counts.all}</span></button>
        <button type="button" data-type="journal" aria-pressed="false">Journal articles <span class="mono">{counts.journal}</span></button>
        <button type="button" data-type="conference" aria-pressed="false">Conference papers <span class="mono">{counts.conference}</span></button>
      </div>
    </div>

    <ol class="pubs" data-list>
      {
        pubs.map((pub, i) => (
          <li class="pub" data-type={pub.data.type}>
            <Citation pub={pub.data} selfAliases={p.selfAliases} index={i + 1} />
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .page__t {
    font-family: var(--serif);
    font-size: var(--t-page);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .head .lede {
    margin-top: 0.85rem;
  }

  .rec {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .rec dt {
    font-family: var(--serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .rec dd {
    font-size: var(--t-meta);
    color: var(--sec);
    margin-top: 0.2rem;
  }

  .rec__src {
    font-size: var(--t-small);
    color: var(--sec);
    margin-top: 0.9rem;
    max-width: 34rem;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .filter__l {
    font-size: var(--t-small);
    color: var(--sec);
  }

  .filter__g {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
  }

  .filter button {
    font: inherit;
    font-size: var(--t-meta);
    font-weight: 500;
    color: var(--sec);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--r);
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  .filter button:hover {
    color: var(--navy);
  }

  .filter button[aria-pressed='true'] {
    color: var(--on-accent);
    background: var(--navy);
  }

  /* Opaque rather than a translucent white: on the light-blue dark-mode accent
     a faded white drops below AA. */
  .filter button[aria-pressed='true'] .mono {
    color: color-mix(in srgb, var(--on-accent) 74%, var(--navy));
  }

  .filter button .mono {
    font-size: var(--t-small);
  }

  .pubs .pub {
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--rule);
  }

  .pubs .pub[hidden] {
    display: none;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  const list = document.querySelector<HTMLElement>('[data-list]');
  if (root && list) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button'));
    const items = Array.from(list.querySelectorAll<HTMLElement>('.pub'));
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const wanted = btn.dataset.type ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((item) => {
          item.hidden = wanted !== 'all' && item.dataset.type !== wanted;
        });
      });
    });
  }
</script>
