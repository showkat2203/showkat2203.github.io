---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { readingMinutes } from '../../lib/reading';
import { getCollection, getEntry } from 'astro:content';
import { blogNode } from '../../lib/schema';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile.yaml is missing the "main" record');
const p = profile.data;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base
  title={`Writing — ${p.name}`}
  description={`Posts by ${p.name} on distributed systems, embedded firmware, graph machine learning, and measuring the performance of concurrent systems.`}
  current="blog"
  pageType="Blog"
  trail={[{ name: 'Writing', path: '/blog/' }]}
  mainEntity={`${new URL('/blog/', Astro.site!).href}#blog`}
  schema={(ctx) => [blogNode(ctx, posts)]}
>
  <div class="shell head">
    <h1 class="page__t">Writing</h1>
    <p class="lede measure">
      Notes on distributed systems, firmware under hard constraints, and machine
      learning over graphs. <a href="/rss.xml">Subscribe by RSS</a>.
    </p>
  </div>

  <div class="shell section">
    {
      posts.length === 0 ? (
        <p class="lede">No posts yet.</p>
      ) : (
        <div class="posts">
          {posts.map((post) => (
            <PostCard post={post} readingMinutes={readingMinutes(post.body)} level="h2" />
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .page__t {
    font-family: var(--serif);
    font-size: var(--t-page);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .head .lede {
    margin-top: 0.85rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }
</style>
