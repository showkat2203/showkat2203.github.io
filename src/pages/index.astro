---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Citation from '../components/Citation.astro';
import PostCard from '../components/PostCard.astro';
import CopyEmail from '../components/CopyEmail.astro';
import InstitutionMark from '../components/InstitutionMark.astro';
import { readingMinutes } from '../lib/reading';
import { buildRecord, fillTokens } from '../lib/record';
import { getCollection, getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile.yaml is missing the "main" record');
const p = profile.data;

const domains = (await getCollection('domains')).sort((a, b) => a.data.order - b.data.order);
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort(
  (a, b) => b.data.start.localeCompare(a.data.start) || a.data.order - b.data.order,
);

const publications = await getCollection('publications');
const headline = publications
  .filter((pub) => pub.data.headlineOrder !== null)
  .sort((a, b) => b.data.year - a.data.year || (a.data.headlineOrder ?? 0) - (b.data.headlineOrder ?? 0));

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const institutions = await getCollection('institutions');
const byKey = new Map(institutions.map((i) => [i.id, i.data]));
const featured = institutions
  .filter((i) => i.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const scholar = await getEntry('scholar', 'main');
if (!scholar) throw new Error('src/content/scholar.yaml is missing the "main" record');
const record = buildRecord(publications, scholar.data);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

---

<Base title={`${p.name} — ${p.role}`} current="home">
  <!-- hero ------------------------------------------------------------- -->
  <section class="shell hero">
    <div class="hero__text">
      <p class="kicker">{p.role} — {p.locationShort}</p>
      <h1 class="hero__h1">{p.headline}</h1>
      <p class="lede hero__lede">{fillTokens(p.positioning, record)}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={p.links.linkedin.url}>LinkedIn</a>
        <a class="btn btn--ghost" href={p.cv.hosted} download>Download CV</a>
        <a class="btn btn--ghost" href={p.links.scholar.url}>Google Scholar</a>
        <a class="btn btn--ghost" href={p.links.github.url}>GitHub</a>
      </div>
    </div>
    <figure class="hero__photo">
      <picture>
        <source type="image/webp" srcset="/img/portrait-480.webp 480w, /img/portrait-800.webp 800w, /img/portrait-1200.webp 1200w" sizes="(max-width: 52rem) 92vw, 34rem" />
        <img src="/img/portrait-800.jpg" width="800" height="800" alt={`${p.name}, ${p.role} in ${p.location}`} fetchpriority="high" />
      </picture>
    </figure>
  </section>

  <!-- credibility ------------------------------------------------------ -->
  <section class="shell orgs" aria-label="Organisations" data-rule>
    <p class="orgs__label">Built systems at</p>
    <ul class="orgs__list">
      {
        featured.map((i) => (
          <li>
            <InstitutionMark
              slug={i.id}
              monogram={i.data.monogram}
              logoSource={i.data.logoSource}
              logoScale={i.data.logoScale}
            />
            <span>{i.data.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- latest ----------------------------------------------------------- -->
  {
    news.length > 0 && (
      <section class="shell section" id="news" aria-labelledby="news-t">
        <div class="section__head">
          <h2 class="h2" id="news-t">Latest</h2>
        </div>
        <ol class="news" data-rule>
          {news.map((n) => (
            <li class="news__row">
              <p class="news__when mono">
                <time datetime={n.data.date.toISOString()}>
                  {n.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </time>
              </p>
              <p class="news__what">
                {n.data.text}
                {n.data.href && n.data.linkLabel && (
                  <>
                    {' '}
                    <a href={n.data.href} rel="noopener">
                      {n.data.linkLabel}
                    </a>
                  </>
                )}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- practice areas --------------------------------------------------- -->
  <section class="shell section" id="about" aria-labelledby="about-t">
    <div class="section__head"><h2 class="h2" id="about-t">What I work on</h2></div>
    <div class="areas">
      {
        domains.map((d) => (
          <article class="area" data-rule>
            <h3 class="area__t">{d.data.label}</h3>
            <p class="area__b">{d.data.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- work ------------------------------------------------------------- -->
  <section class="shell section" id="work" aria-labelledby="work-t">
    <div class="section__head">
      <h2 class="h2" id="work-t">Selected work</h2>
      <p class="section__more">Chosen for the difficulty of the problem, not how recent it is</p>
    </div>
    {work.map((entry) => <WorkCard entry={entry.data} />)}
  </section>

  <!-- publications ----------------------------------------------------- -->
  <section class="shell section" id="publications" aria-labelledby="pubs-t">
    <div class="section__head">
      <h2 class="h2" id="pubs-t">Publications</h2>
      <a class="section__more" href="/publications">All {record.publications} publications</a>
    </div>
    <ol class="pubs">
      {
        headline.map((pub, i) => (
          <li>
            <Citation pub={pub.data} selfAliases={p.selfAliases} index={i + 1} />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- writing ---------------------------------------------------------- -->
  {
    posts.length > 0 && (
      <section class="shell section" id="writing" aria-labelledby="writing-t">
        <div class="section__head">
          <h2 class="h2" id="writing-t">Writing</h2>
          <a class="section__more" href="/blog">All posts</a>
        </div>
        <div class="posts">
          {posts.map((post) => (
            <PostCard post={post} readingMinutes={readingMinutes(post.body)} />
          ))}
        </div>
      </section>
    )
  }

  <!-- experience ------------------------------------------------------- -->
  <section class="shell section" id="experience" aria-labelledby="exp-t">
    <div class="section__head">
      <h2 class="h2" id="exp-t">Experience</h2>
      <a class="section__more" href="/cv">Full CV</a>
    </div>
    <ol class="tl">
      {
        experience.map((role) => (
          <li class="tl__row" data-rule>
            <p class="tl__when mono">{role.data.period}</p>
            <div class="tl__what">
              <h3 class="tl__role">
                {role.data.role}
                {role.data.current && <span class="tl__now">current</span>}
              </h3>
              <p class="tl__org">
                <InstitutionMark
                  slug={role.data.institution}
                  monogram={byKey.get(role.data.institution)?.monogram ?? '—'}
                  logoSource={byKey.get(role.data.institution)?.logoSource ?? null}
                  logoScale={byKey.get(role.data.institution)?.logoScale ?? 1}
                  size="sm"
                />
                <span>{role.data.org}, {role.data.location}</span>
              </p>
              {role.data.summary && <p class="tl__sum">{role.data.summary}</p>}
              {role.data.concurrentWith && <p class="tl__con">{role.data.concurrentWith}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- contact ---------------------------------------------------------- -->
  <section class="shell section" id="contact" aria-labelledby="contact-t">
    <div class="section__head"><h2 class="h2" id="contact-t">Contact</h2></div>
    <div class="card contact">
      <dl class="contact__grid">
        <div>
          <dt>Email</dt>
          <dd><CopyEmail email={p.email} /></dd>
        </div>
        <div>
          <dt>Code</dt>
          <dd><a href={p.links.github.url}>github.com/showkat2203</a></dd>
        </div>
        <div>
          <dt>Papers</dt>
          <dd><a href={p.links.scholar.url}>Google Scholar profile</a></dd>
        </div>
        <div>
          <dt>Profile</dt>
          <dd><a href={p.links.linkedin.url}>LinkedIn profile</a></dd>
        </div>
        <div>
          <dt>CV</dt>
          <dd><a href="/cv">Read on this site</a>, or <a href={p.cv.hosted} download>download the PDF</a></dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{p.residency}</dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: center;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__h1 {
    font-family: var(--serif);
    font-size: var(--t-display);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.028em;
    margin-top: 0.6rem;
    max-width: 19ch;
    text-wrap: balance;
  }

  .hero__lede {
    margin-top: 1.1rem;
    max-width: 48ch;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .hero__photo {
    position: relative;
  }

  /* The photograph carries its own background, so the frame is just a hairline
     and a clip — the same image serves both themes. The clip goes on the
     picture rather than the figure, because the figure is the positioning
     context for the offset rule below, which sits outside the photo's bounds
     and would be cropped away by an overflow clip here. */
  .hero__photo picture {
    display: block;
    border: 1px solid var(--rule);
    border-radius: var(--r);
    overflow: hidden;
  }

  .hero__photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* A thin offset rule behind the photo: the one ornamental move on the page.
     The inset is a custom property so the load animation in global.css can
     animate to whatever this breakpoint's offset happens to be. */
  .hero__photo::after {
    --frame-inset: 0.85rem -0.85rem -0.85rem 0.85rem;
    content: '';
    position: absolute;
    inset: var(--frame-inset);
    border: 1px solid var(--navy);
    border-radius: var(--r);
    z-index: -1;
  }

  .orgs {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.35rem;
    border-top: 1px solid var(--rule);
  }

  .orgs__label {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--t-meta);
    color: var(--sec);
    padding-top: 0.7rem;
    flex: none;
  }

  /* A grid rather than a wrapping flex row: with uniform logo tiles the items
     no longer fit on one line at every width, and columns that line up read as
     deliberate where a ragged second line does not. */
  .orgs__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 0.85rem 1.5rem;
    flex: 1;
  }

  .orgs__list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.008em;
  }

  .news {
    border-top: 1px solid var(--rule);
  }

  .news__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.2rem 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .news__when {
    font-size: var(--t-meta);
    color: var(--sec);
    padding-top: 0.12rem;
  }

  .news__what {
    font-size: 0.9375rem;
    max-width: 52rem;
    text-wrap: pretty;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  .area {
    border-top: 2px solid var(--navy);
    padding-top: 0.9rem;
  }

  .area__t {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .area__b {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--sec);
    text-wrap: pretty;
  }

  .pubs li {
    padding-block: 1.35rem;
    border-top: 1px solid var(--rule);
  }

  .pubs li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
  }

  /* A lone post should not stretch the full page width. */
  .posts > :only-child {
    max-width: 34rem;
  }

  .tl__row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.35rem 1.5rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--rule);
  }

  .tl__row:first-child {
    border-top: 0;
  }

  .tl__when {
    font-size: var(--t-meta);
    color: var(--sec);
    padding-top: 0.2rem;
  }

  .tl__role {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .tl__now {
    font-size: var(--t-small);
    font-weight: 500;
    font-family: var(--mono);
    color: var(--on-accent);
    background: var(--navy);
    border-radius: var(--r);
    padding: 0.1rem 0.4rem;
  }

  .tl__org {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--t-meta);
    color: var(--sec);
    margin-top: 0.35rem;
  }

  .tl__sum {
    margin-top: 0.45rem;
    font-size: 0.9375rem;
    color: var(--sec);
    max-width: 48rem;
    text-wrap: pretty;
  }

  .tl__con {
    margin-top: 0.35rem;
    font-size: var(--t-meta);
    color: var(--sec);
    border-left: 2px solid var(--rule);
    padding-left: 0.6rem;
  }

  .contact {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.35rem 2rem;
  }

  .contact__grid dt {
    font-size: var(--t-small);
    color: var(--sec);
    font-family: var(--mono);
  }

  .contact__grid dd {
    margin-top: 0.25rem;
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__photo {
      order: -1;
      max-width: 20rem;
    }
    .hero__photo::after {
      --frame-inset: 0.6rem -0.6rem -0.6rem 0.6rem;
    }
    .areas {
      grid-template-columns: minmax(0, 1fr);
    }
    .tl__row,
    .news__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
