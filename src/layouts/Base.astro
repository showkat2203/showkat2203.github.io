---
import '../styles/global.css';
import { getCollection, getEntry } from 'astro:content';
import { buildRecord, fillTokens } from '../lib/record';
import {
  breadcrumbs,
  pageNode,
  personNode,
  serialiseGraph,
  websiteNode,
  type JsonLd,
  type PageType,
  type SiteContext,
} from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'publications' | 'prep' | 'blog' | 'cv';
  /** Social card override, for blog posts. */
  ogImage?: string;
  /** What that card shows. Required alongside ogImage, or the alt text would
   *  still describe the portrait on the default card. */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** What this URL is, for structured data. */
  pageType?: PageType;
  /** Breadcrumb steps after Home. Omitted on the home page. */
  trail?: Array<{ name: string; path: string }>;
  /** `@id` of this page's principal subject. */
  mainEntity?: string;
  /** Set where the page's subject matter really is the person. */
  aboutPerson?: boolean;
  /** Extra JSON-LD nodes this page contributes to the graph. */
  schema?: (ctx: SiteContext) => Array<JsonLd | null>;
  /** Publication and modification times, for an article. */
  published?: Date;
  modified?: Date;
  /** Tags, emitted as article:tag. */
  tags?: string[];
}

const {
  title,
  description,
  current = 'home',
  ogImage,
  ogImageAlt,
  ogType = 'website',
  pageType = 'WebPage',
  trail = [],
  mainEntity,
  aboutPerson = false,
  schema,
  published,
  modified,
  tags = [],
} = Astro.props;
const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile.yaml is missing the "main" record');
const p = profile.data;

const record = buildRecord(await getCollection('publications'));

const desc = fillTokens(description ?? p.metaDescription, record);
// Canonical must name the URL the server serves without redirecting, which
// for a directory route is the trailing-slash form.
const path = Astro.url.pathname;
const canonical = new URL(path.endsWith('/') ? path : `${path}/`, Astro.site);
const image = new URL(ogImage ?? '/og.png', Astro.site);
const imageAlt = ogImageAlt ?? `${p.name}, ${p.role}`;
const site = Astro.site!;

// The Person node is described once and referenced everywhere, so it is built
// here from the collections rather than per page.
const experience = await getCollection('experience');
const cvSections = await getCollection('cv');
const education = cvSections.find((section) => section.id === 'education');

const ctx: SiteContext = {
  site,
  profile: p,
  siteDescription: fillTokens(p.metaDescription, record),
  worksFor: experience.find((role) => role.data.current)?.data.org ?? null,
  alumniOf: (education?.data.entries ?? []).map((entry) => entry.institution),
  knowsAbout: (await getCollection('domains'))
    .sort((a, b) => a.data.order - b.data.order)
    .map((domain) => domain.data.label),
};

const graph = serialiseGraph([
  personNode(ctx),
  websiteNode(ctx),
  pageNode(ctx, { canonical, type: pageType, title, description: desc, image, mainEntity, aboutPerson }),
  breadcrumbs(site, canonical, trail),
  ...(schema?.(ctx) ?? []),
]);

// Directory form throughout. GitHub Pages serves each route from its own
// index.html and 301s the slashless spelling to it, so a link without the
// slash costs every visitor and every crawler an extra hop.
const nav = [
  { href: '/#work', label: 'Work', key: 'home' },
  { href: '/publications/', label: 'Publications', key: 'publications' },
  { href: '/interview-prep/', label: 'Interview prep', key: 'prep' },
  { href: '/blog/', label: 'Writing', key: 'blog' },
  { href: '/cv/', label: 'CV', key: 'cv' },
  { href: '/#contact', label: 'Contact', key: 'contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <meta name="author" content={p.name} />
    <!-- Default is index,follow; this only lifts the image-preview cap, which
         is what lets the portrait and social card show at full size. -->
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="preload" href="/fonts/source-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={p.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {(modified ?? published) && (
      <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />
    )}
    {ogType === 'article' && <meta property="article:author" content={p.name} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${p.name} — writing`} href="/rss.xml" />
    <meta name="theme-color" content="#fbfaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1419" media="(prefers-color-scheme: dark)" />

    <script type="application/ld+json" is:inline set:html={graph} />

    <script is:inline>
      // Runs before first paint: without it the page renders in the system
      // theme for a frame before a stored choice is applied.
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* private mode: fall through to the system preference */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="mast">
      <div class="shell mast__in">
        <a class="mast__mark" href="/">{p.name}</a>
        <div class="mast__right">
          <nav aria-label="Primary">
            <ul>
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <button
            type="button"
            class="theme no-print"
            data-theme-toggle
            aria-pressed="false"
            title="Switch between light and dark"
          >
            <svg class="theme__i theme__i--sun" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="3.6" />
              <g stroke-linecap="round">
                <path d="M10 1.6v2.2M10 16.2v2.2M1.6 10h2.2M16.2 10h2.2M4.1 4.1l1.6 1.6M14.3 14.3l1.6 1.6M15.9 4.1l-1.6 1.6M5.7 14.3l-1.6 1.6" />
              </g>
            </svg>
            <svg class="theme__i theme__i--moon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M16.3 12.6A7 7 0 0 1 7.4 3.7a7 7 0 1 0 8.9 8.9z" />
            </svg>
            <span class="theme__label">Dark mode</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="foot no-print">
      <div class="shell foot__in">
        <p>{p.name} — {p.location}</p>
        <ul class="foot__links">
          <li><a href={`mailto:${p.email}`}>Email</a></li>
          {p.links.scholar.url && <li><a href={p.links.scholar.url}>Google Scholar</a></li>}
          <li><a href={p.links.github.url!}>GitHub</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </footer>

    <style>
      .mast {
        border-bottom: 1px solid var(--rule);
        background: color-mix(in srgb, var(--bg) 97%, transparent);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .mast__in {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 2rem;
        align-items: center;
        justify-content: space-between;
        padding-block: 0.9rem;
      }

      .mast__mark {
        font-family: var(--serif);
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.012em;
        color: var(--ink);
        text-decoration: none;
      }

      .mast__right {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem 1.25rem;
      }

      .theme {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        background: none;
        border: 1px solid var(--rule);
        border-radius: var(--r);
        color: var(--sec);
        cursor: pointer;
      }

      .theme:hover {
        color: var(--navy);
        border-color: var(--navy);
      }

      .theme__label {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
      }

      .theme__i {
        width: 1.0625rem;
        height: 1.0625rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
      }

      .theme__i--sun circle {
        fill: currentColor;
        stroke: none;
      }

      .theme__i--moon {
        fill: currentColor;
        stroke: none;
      }

      /* Show the icon for the theme the button switches *to*. */
      .theme__i--sun {
        display: none;
      }

      :root[data-theme='dark'] .theme__i--sun {
        display: block;
      }

      :root[data-theme='dark'] .theme__i--moon {
        display: none;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .theme__i--sun {
          display: block;
        }
        :root:not([data-theme='light']) .theme__i--moon {
          display: none;
        }
      }

      .mast nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.5rem;
      }

      .mast nav a {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--sec);
        text-decoration: none;
      }

      .mast nav a:hover,
      .mast nav a:focus-visible {
        color: var(--navy);
      }

      .mast nav a[aria-current='page'] {
        color: var(--ink);
        font-weight: 600;
      }

      .foot {
        margin-top: clamp(4rem, 8vw, 6rem);
        border-top: 1px solid var(--rule);
        padding-block: 1.75rem 3rem;
      }

      .foot__in {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 2rem;
        justify-content: space-between;
        align-items: baseline;
        font-size: var(--t-meta);
        color: var(--sec);
      }

      .foot__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.4rem;
      }

      @media print {
        .theme {
          display: none;
        }
        .mast {
          position: static;
          border-bottom: 0;
          backdrop-filter: none;
        }
        .mast nav {
          display: none;
        }
        .mast__in {
          padding-block: 0;
        }
        .mast__mark {
          font-size: 15pt;
        }
      }
    </style>
    <script>
      import '../scripts/motion';
    </script>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const label = btn?.querySelector<HTMLElement>('.theme__label');
      const root = document.documentElement;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

      const isDark = () =>
        root.dataset.theme === 'dark' || (!root.dataset.theme && systemDark.matches);

      const sync = () => {
        const dark = isDark();
        btn?.setAttribute('aria-pressed', String(dark));
        if (label) label.textContent = dark ? 'Switch to light mode' : 'Switch to dark mode';
      };

      btn?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* private mode: the choice just will not persist */
        }
        sync();
      });

      // Follow the system while no explicit choice is stored.
      systemDark.addEventListener('change', () => {
        if (!root.dataset.theme) sync();
      });

      sync();
    </script>
  </body>
</html>
